FROM golang:1.27.4-alpine AS build

WORKDIR /src

COPY ./go.mod ./go.mod

RUN go mod download

COPY . .

RUN go test -v -race ./... && \
    CGO_ENABLED=1 GOOS=linux go build -ldflags "-s -w" -o /app/mercury ./


FROM scratch

# Copy SSL/TLS root certificates (required for outbound HTTPS requests)
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

COPY --from=builder /app/mercury /mercury

USER 65534:65534
EXPOSE 12000
ENTRYPOINT ["/mercury"]
